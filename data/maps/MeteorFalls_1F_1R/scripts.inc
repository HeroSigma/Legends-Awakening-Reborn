MeteorFalls_1F_1R_EventScript_ProfCozmo::
	lock
	faceplayer
	goto_if_set FLAG_MET_PROF_COZMO, MeteorFalls_1F_1R_EventScript_MetCozmo
	setflag FLAG_MET_PROF_COZMO
	msgbox MeteorFalls_1F_1R_Text_MeetProfCozmo, MSGBOX_DEFAULT
	release
	end

MeteorFalls_1F_1R_EventScript_MetCozmo::
	msgbox MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney, MSGBOX_DEFAULT
	release
	end

MeteorFalls_1F_1R_Text_WithThisMeteorite:
	.string "The cavern readings match.\nGet the meteorite to Mt. Chimney.$"

MeteorFalls_1F_1R_Text_DontExpectMercyFromMagma:
	.string "You again? Stay out of our work.\nYou've already delayed us.$"

MeteorFalls_1F_1R_Text_HoldItRightThereMagma:
	.string "Tabitha! The offshore data is in.\nGiovanni wants the relay ready.$"

MeteorFalls_1F_1R_Text_BeSeeingYouTeamAqua:
	.string "Then we're finished here.\nKeep that Trainer off our route.$"

MeteorFalls_1F_1R_Text_ArchieSeenYouBefore:
	.string "You again. I warned you in Slateport.\pOur crews are working on the same\noperation. This isn't a rivalry.\pAnd you keep getting in the way.$"

MeteorFalls_1F_1R_Text_BossWeShouldChaseMagma:
	.string "Commander, transport is ready.\nWe'll meet the others at the summit.$"

MeteorFalls_1F_1R_Text_ArchieYesNoTellingWhatMagmaWillDo:
	.string "Then move out. The calibration\nwindow won't stay open forever.$"

MeteorFalls_1F_1R_Text_ArchieFarewell:
	.string "You want answers? Watch the mountain.\nBut don't expect us to protect you.$"

MeteorFalls_1F_1R_Text_MeetProfCozmo:
	.string "I followed them to check the cavern.\nThey've finished calibrating the stone.\pThe mountain is their next stop!$"

MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney:
	.string "The meteorite can amplify the signal.\nIt must be stopped before it overheats.$"


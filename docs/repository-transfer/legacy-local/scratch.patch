 //
-// If you choose to widen Map Sections, be aware that Met Locations (below)
-// are based on Map Sections and will also be widened.
-typedef u8  mapsec_u8_t;
+// ---------------------------------------------------------------------------
+// LEGENDS AWAKENING: WIDENED FROM u8 TO u16.
+//
+// This project defines 328 map sections across five regions
+// (Hoenn 326, Kanto 251, Johto 251, Sevii 251, Sinnoh 65). An 8-bit canonical
+// type caps at 255, so sections 256+ silently wrapped to low values and
+// aliased onto Hoenn's early towns.
+//
+// Critically, the special met-location sentinels (0xFD/0xFE/0xFF) shared the
+// same 8-bit value space, so a late-table section was indistinguishable from
+// METLOC_FATEFUL_ENCOUNTER. That is silent save-data corruption, not a
+// cosmetic issue, and is why this widening is mandatory.
+//
+// COST (see the upstream note below): metloc appears inside every Pokemon's
+// stored data, so widening grows each Pokemon record. SaveBlock/Party layouts
+// must be re-verified after this change.
+// ---------------------------------------------------------------------------
+typedef u16 mapsec_u8_t;   // name kept for source compatibility; now 16-bit
 typedef u16 mapsec_u16_t;
 typedef s16 mapsec_s16_t;
 typedef s32 mapsec_s32_t;
 
 // Met Locations for caught Pokemon use the same values as Map Sections,
-// except that 0xFD, 0xFE, and 0xFF have special meanings.
+// except that the sentinels declared in constants/region_map_sections.h have
+// special meanings.
+//
+// LEGENDS AWAKENING: those sentinels are widened to 16 bits
+// (0xFFFD/0xFFFE/0xFFFF) so they stay outside the 328-entry section ID range.
 //
 // Because this value appears inside every Pokemon's data, widening it will
 // consume a lot more space within flash memory. The space usage will be
